<Project>
  <PropertyGroup>
    <!-- Default to net9.0 while dynamically including net10.0 and future .NET 11+ targets when installed -->
    <HayabusaTargetFrameworks>net9.0</HayabusaTargetFrameworks>
    <HayabusaTargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">$(HayabusaTargetFrameworks);net10.0</HayabusaTargetFrameworks>
    <HayabusaTargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '19.0'))">$(HayabusaTargetFrameworks);net11.0</HayabusaTargetFrameworks>
    <TargetFrameworks Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">$(HayabusaTargetFrameworks)</TargetFrameworks>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>Nullable;CS8509;CS8524;CA1062;CA1502;CA1505;CA2000</WarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <!-- Package & OSS Metadata -->
    <Authors>Hayabusa Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ANIZA15/hayabusa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Include LICENSE and THIRD-PARTY-NOTICES.md in all NuGet packages and publish outputs -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')">
    <None Include="$(MSBuildThisFileDirectory)LICENSE"
          Pack="true"
          PackagePath="\"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')">
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="\"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
