root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,props,targets,csproj,sln}]
indent_size = 2

[*.cs]
# File-scoped namespaces (Coding Standards §3.1)
csharp_style_namespace_declarations = file_scoped:error

# Sealed classes by default & readonly structs (Coding Standards §3.3, §3.4)
dotnet_diagnostic.CA1852.severity = error

# Cyclomatic Complexity & Maintainability (Cyclomatic Complexity Skill §2.1)
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1505.severity = error
dotnet_diagnostic.CA1506.severity = warning

# Strict Typing & Exhaustive Switch (Strict Typing Skill §1)
dotnet_diagnostic.CS8509.severity = error
dotnet_diagnostic.CS8524.severity = error
dotnet_diagnostic.CA1062.severity = error

# Zero-Leak Memory & Disposal Guarantees (Zero-Leak Memory Skill §1)
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA1816.severity = error
dotnet_diagnostic.CA2012.severity = error

# Thread-per-Core Architecture: Never escape to ThreadPool via ConfigureAwait(false) (Thread-per-Core Skill §1)
dotnet_diagnostic.CA2007.severity = none

# Unsigned primitives (ulong ConnectionId/RoomId/TickNumber) are intentional (Strict Typing Skill §2)
dotnet_diagnostic.CA1014.severity = none

# Exception messages are invariant English strings
dotnet_diagnostic.CA1303.severity = none

# Allow *Impl / *Flags / *Collection / *Queue / *Stream / *Ex naming where architecturally appropriate
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1034.severity = none

# Compact byte-backed enums (e.g. FrameParseError : byte) and Result<T, E>.Success static factories (Strict Typing Skill §3.2)
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1019.severity = none
dotnet_diagnostic.CA1515.severity = none




[tests/**/*.cs]
# Unit testing naming convention: MethodName_Condition_ExpectedBehavior (Unit Testing Skill §1)
dotnet_diagnostic.CA1707.severity = none
# Deterministic seeded Random is required for Structure-Aware Fuzzing (Penetration Testing Skill §2.2)
dotnet_diagnostic.CA5394.severity = none


