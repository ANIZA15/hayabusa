<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hayabusa.Core" Version="0.1.0" />
    <PackageReference Include="Hayabusa.Rpc" Version="0.1.0" />
    <PackageReference Include="Hayabusa.Transport" Version="0.1.0" />
    <PackageReference Include="Hayabusa.Runtime" Version="0.1.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>
</Project>
