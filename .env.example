# Hayabusa Server Environment Configuration
# Copy this file to `.env` when running `docker compose up -d`

# Bind address inside the container
HAYABUSA_BIND_ADDRESS=0.0.0.0

# HTTP / REST / Minimal API Port
HAYABUSA_HTTP_PORT=5000

# MemoryPack RPC / Realtime Game Room Port
HAYABUSA_RPC_PORT=5001

# Number of dedicated Thread-per-Core worker threads (0 = auto-detect logical CPU cores)
HAYABUSA_WORKER_THREADS=0

# Game Room Tick frequency in Hz (e.g. 60 for 60fps, 30 for 30fps)
HAYABUSA_TICK_RATE=60

# I/O Transport Backend: "auto" (prefers Linux io_uring, falls back to Socket/IOCP), "io_uring", or "socket"
HAYABUSA_TRANSPORT=auto
